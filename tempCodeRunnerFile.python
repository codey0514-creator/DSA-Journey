class Node():
    def __init__(self , data):
        self.data = data
        self.next = None
class LinkedList():
    def __init__(self , val):
        first = Node(val)
        self.head = first
        self.tail = first
    def push_front(self , val):
        new = Node(val)
        new.next = self.head
        self.head = new
    def push_back(self , val):
        new = Node(val)
        self.tail.next = new
        self.tail = new
l1 = LinkedList(10)
print(l1.head , l1.tail)
l1.push_front(5)
l1.push_back(20)
print(l1.head.data , l1.tail.data)
        
